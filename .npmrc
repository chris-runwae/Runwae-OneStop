# Hoist Babel + Metro plugin sub-deps to the workspace root so
# @babel/core can resolve them when presets list them as transitive
# requirements. Without this, EAS Update / Metro fails with
# "Cannot find module '@babel/plugin-transform-react-jsx'" (or
# similar) because pnpm's strict hoisting hides them.
public-hoist-pattern[]=*babel*
public-hoist-pattern[]=*eslint*
